Given smarty (array indexing):
  {$foo[0]}
  {$foo['bar']}
  {$foo["bar"]}

Execute (array index):
  AssertEqual 'smartyVariable', SyntaxOf('foo', 1)
  AssertEqual 'smartyVariable', SyntaxOf('foo', 2)
  AssertEqual 'smartyInBracket', SyntaxOf('bar', 1)
  AssertEqual 'smartyVariable', SyntaxOf('foo', 3)
  AssertEqual 'smartyInBracket', SyntaxOf('bar', 2)

############################################

Given smarty (array indexing with array index):
  {$foo[$bar]}

Execute (array index):
  AssertEqual 'smartyDollarSign', SyntaxOf('\$', 1)
  AssertEqual 'smartyVariable', SyntaxOf('foo')
  AssertEqual 'smartyDollarSign', SyntaxOf('\$', 2)
  AssertEqual 'smartyVariable', SyntaxOf('bar')

############################################

Given smarty (object property and method call):
  {$user->name}
  {$user->getName()}
  {$user->getDetails($arg1, 'arg2')}

Execute (object access):
  AssertEqual 'smartyVariable', SyntaxOf('user', 1)
  AssertEqual 'smartyGlue', SyntaxOf('\->', 1)
  AssertEqual 'smartyVariable', SyntaxOf('user', 2)
  AssertEqual 'smartyGlue', SyntaxOf('\->', 2)
  AssertEqual 'smartyVariable', SyntaxOf('user', 3)
  AssertEqual 'smartyGlue', SyntaxOf('\->', 3)
  AssertEqual 'smartyVariable', SyntaxOf('arg1')
  AssertEqual 'smartyString', SyntaxOf('arg2')

############################################

Given smarty (dot access for array elements):
  {$foo.bar}
  {$foo.bar.baz}
  {$foo.$bar}

Execute (dot access):
  AssertEqual 'smartyVariable', SyntaxOf('foo', 1)
  AssertEqual 'smartyGlue', SyntaxOf('\.', 1)
  AssertEqual 'smartyVariable', SyntaxOf('foo', 2)
  AssertEqual 'smartyGlue', SyntaxOf('\.', 2)
  AssertEqual 'smartyVariable', SyntaxOf('foo', 3)
  AssertEqual 'smartyVariable', SyntaxOf('bar', 3)

############################################

Given smarty (array index then text indexing):
  {$foo.[42].textindex}

Execute (array indexes):
  AssertEqual 'smartyVariable', SyntaxOf('foo')
  AssertEqual 'smartyVariable', SyntaxOf('textindex')

###########################################

Given smarty (digit then text indexing):
  {$foo.42.textindex}

Execute (array indexes):
  AssertEqual 'smartyVariable', SyntaxOf('foo')
  AssertEqual 'smartyVariable', SyntaxOf('42')
  AssertEqual 'smartyVariable', SyntaxOf('textindex')

###########################################

Given smarty (config variables with hash and dollar):
  {#foo#}
  {#foo_bar#}
  {$smarty.config.foo}

Execute (config variables):
  AssertEqual 'smartyHashSign', SyntaxOf('#', 1)
  AssertEqual 'smartyVariable', SyntaxOf('foo', 1)
  AssertEqual 'smartyHashSign', SyntaxOf('#', 2)
  AssertEqual 'smartyVariable', SyntaxOf('foo_bar')
  AssertEqual 'smartyVariable', SyntaxOf('smarty')
  AssertEqual 'smartyGlue', SyntaxOf('\.', 1)

############################################

Given smarty (special $smarty variables):
  {$smarty.now}
  {$smarty.const.PHP_VERSION}
  {$smarty.capture.foo}
  {$smarty.get.page}
  {$smarty.post.user}
  {$smarty.session.id}
  {$smarty.server.SERVER_NAME}
  {$smarty.env.PATH}
  {$smarty.current_dir}
  {$smarty.version}
  {$smarty.block.child}
  {$smarty.block.parent}

Execute ($smarty reserved variable):
  AssertEqual 'smartyVariable', SyntaxOf('smarty', 1)
  AssertEqual 'smartyVariable', SyntaxOf('smarty', 2)
  AssertEqual 'smartyVariable', SyntaxOf('smarty', 3)
  AssertEqual 'smartyVariable', SyntaxOf('smarty', 4)
  AssertEqual 'smartyVariable', SyntaxOf('smarty', 5)
  AssertEqual 'smartyVariable', SyntaxOf('smarty', 6)
  AssertEqual 'smartyVariable', SyntaxOf('smarty', 7)
  AssertEqual 'smartyVariable', SyntaxOf('smarty', 8)
  AssertEqual 'smartyVariable', SyntaxOf('smarty', 9)
  AssertEqual 'smartyVariable', SyntaxOf('smarty', 10)
  AssertEqual 'smartyVariable', SyntaxOf('smarty', 11)
  AssertEqual 'smartyVariable', SyntaxOf('smarty', 12)

############################################

Given smarty (numbers decimal and hexadecimal):
  {assign var='dec' value=123}
  {assign var='neg' value=-456}
  {assign var='float' value=3.14}
  {assign var='neg_float' value=-0.5}
  {assign var='hex' value=0x1f}
  {if $x == 456}
  {/if}
  {if $x == -456}
  {/if}
  {if $x == 3.14}
  {/if}
  {if $x == -0.5}
  {/if}

Execute (numbers):
  AssertEqual 'smartyNumber', SyntaxOf('123')
  AssertEqual 'smartyNumber', SyntaxOf('-456', 1)
  AssertEqual 'smartyNumber', SyntaxOf('3.14', 1)
  AssertEqual 'smartyNumber', SyntaxOf('-0.5', 1)
  AssertEqual 'smartyNumber', SyntaxOf('0x1f')
  AssertEqual 'smartyNumber', SyntaxOf('456', 1)
  AssertEqual 'smartyNumber', SyntaxOf('-456', 2)
  AssertEqual 'smartyNumber', SyntaxOf('3.14', 2)
  AssertEqual 'smartyNumber', SyntaxOf('-0.5', 2)

############################################

Given smarty (booleans true and false):
  {assign var='t' value=true}
  {assign var='f' value=false}

Execute (booleans):
  AssertEqual 'smartyBoolean', SyntaxOf('true')
  AssertEqual 'smartyBoolean', SyntaxOf('false')
