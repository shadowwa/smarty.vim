Given smarty (truncate modifier):
  {$articleTitle|truncate}
  {$articleTitle|truncate:30}
  {$articleTitle|truncate:30:"foo"}
  {$articleTitle|truncate:30:"foo":true}
  {$articleTitle|truncate:30:"foo":true:true}

Execute (TODO: truncate modifier):
  AssertEqual 'smartyModifier', SyntaxOf('truncate', 1)
  AssertEqual 'smartyModifier', SyntaxOf('truncate', 2)
  AssertEqual 'smartyParameter', SyntaxOf('30', 1)
  AssertEqual 'smartyModifier', SyntaxOf('truncate', 3)
  AssertEqual 'smartyParameter', SyntaxOf('30', 2)
  AssertEqual 'smartyStringDouble', SyntaxOf('foo', 1)
  AssertEqual 'smartyModifier', SyntaxOf('truncate', 4)
  AssertEqual 'smartyParameter', SyntaxOf('30', 3)
  AssertEqual 'smartyStringDouble', SyntaxOf('foo', 2)
  AssertEqual 'smartyBoolean', SyntaxOf('true', 1)
  AssertEqual 'smartyModifier', SyntaxOf('truncate', 5)
  AssertEqual 'smartyParameter', SyntaxOf('30', 4)
  AssertEqual 'smartyStringDouble', SyntaxOf('foo', 3)
  AssertEqual 'smartyBoolean', SyntaxOf('true', 2)
  AssertEqual 'smartyBoolean', SyntaxOf('true', 3)

