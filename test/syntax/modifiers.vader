  AssertEqual 'smartyStringDouble', SyntaxOf('/\[\\r\\t\\n\]/')
  AssertEqual 'smartyModifier', SyntaxOf('replace')
  AssertEqual 'smartyStringDouble', SyntaxOf('foo')
  AssertEqual 'smartyStringDouble', SyntaxOf('bar')

