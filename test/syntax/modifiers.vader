  {$articleTitle|wordwrap:20:"\n"}
  {$articleTitle|wordwrap:30:"<br />\n":true}

Execute (TODO: wordwrap modifier):
  AssertEqual 'smartyModifier', SyntaxOf('wordwrap', 1)
  AssertEqual 'smartyParameter', SyntaxOf('30', 1)
  AssertEqual 'smartyModifier', SyntaxOf('wordwrap', 2)
  AssertEqual 'smartyParameter', SyntaxOf('20')
