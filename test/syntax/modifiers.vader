Given smarty (simple modifier):
  {$name|capitalize}
  {$name|cat:" world"}
  {$count|count_characters}
  {$count|count_characters:true}
  {$words|count_paragraphs}
  {$words|count_sentences}
  {$words|count_words}

Execute (TODO: character and word modifiers):
  AssertEqual 'smartyModifier', SyntaxOf('capitalize')
  AssertEqual 'smartyModifier', SyntaxOf('cat')
  AssertEqual 'smartyStringDouble', SyntaxOf('world')
  AssertEqual 'smartyModifier', SyntaxOf('count_characters', 1)
  AssertEqual 'smartyModifier', SyntaxOf('count_characters', 2)
  AssertEqual 'smartyBoolean', SyntaxOf('true')
  AssertEqual 'smartyModifier', SyntaxOf('count_paragraphs')
  AssertEqual 'smartyModifier', SyntaxOf('count_sentences')
  AssertEqual 'smartyModifier', SyntaxOf('count_words')

############################################

# can also be used as a function
Given smarty (count modifier):
  {$myArray|count}

Execute (count modifiers):
  AssertEqual 'smartyModifier', SyntaxOf('count')

############################################

Given smarty (date_format modifier):
  {$yesterday|date_format}
  {$yesterday|date_format:"%A, %B %e, %Y"}
  {$yesterday|date_format:"%D":"-"}

Execute (date_format modifier and parameters):
  AssertEqual 'smartyModifier', SyntaxOf('date_format', 1)
  AssertEqual 'smartyModifier', SyntaxOf('date_format', 2)
  AssertEqual 'smartyStringDouble', SyntaxOf('%A')
  AssertEqual 'smartyModifier', SyntaxOf('date_format', 3)
  AssertEqual 'smartyStringDouble', SyntaxOf('%D')
  AssertEqual 'smartyStringDouble', SyntaxOf('-')

############################################

Given smarty (debug_print_var modifier):
  {$myVar|debug_print_var}
  {$myVar|debug_print_var:5}
  {$myVar|debug_print_var:10:40}

Execute (debug_print_var modifiers):
  AssertEqual 'smartyModifier', SyntaxOf('debug_print_var', 1)
  AssertEqual 'smartyModifier', SyntaxOf('debug_print_var', 2)
  AssertEqual 'smartyModifier', SyntaxOf('debug_print_var', 3)

############################################

Given smarty (default modifier):
  {$articleTitle|default:'no title'}

Execute (default modifier):
  AssertEqual 'smartyModifier', SyntaxOf('default')
  AssertEqual 'smartyString', SyntaxOf('no title')

############################################

# can also be used as a function
Given smarty (empty modifier):
  {if $myVar|empty}it's an empty variable{/if}

Execute (empty modifiers):
  AssertEqual 'smartyModifier', SyntaxOf('empty')

############################################

Given smarty (escape modifier):
  {$articleTitle|escape}
  {$articleTitle|escape:'html'}
  {$articleTitle|escape:'htmlall'}
  {$articleTitle|escape:'url'}
  {$articleTitle|escape:'quotes'}
  {$articleTitle|escape:'hex'}
  {$articleTitle|escape:'hexentity'}
  {$articleTitle|escape:'javascript'}
  {$articleTitle|escape:'mail'}

Execute (escape modifier and formats):
  AssertEqual 'smartyModifier', SyntaxOf('escape', 1)
  AssertEqual 'smartyModifier', SyntaxOf('escape', 2)
  AssertEqual 'smartyString', SyntaxOf('html')
  AssertEqual 'smartyString', SyntaxOf('htmlall')
  AssertEqual 'smartyString', SyntaxOf('url')
  AssertEqual 'smartyString', SyntaxOf('quotes')
  AssertEqual 'smartyString', SyntaxOf('hex')
  AssertEqual 'smartyString', SyntaxOf('hexentity')
  AssertEqual 'smartyString', SyntaxOf('javascript')
  AssertEqual 'smartyString', SyntaxOf('mail')

############################################

Given smarty (from_charset and to_charset modifiers):
  {$text|from_charset:"latin1"}
  {$text|to_charset:"utf-8"}

Execute (charset modifiers):
  AssertEqual 'smartyModifier', SyntaxOf('from_charset')
  AssertEqual 'smartyStringDouble', SyntaxOf('latin1')
  AssertEqual 'smartyModifier', SyntaxOf('to_charset')
  AssertEqual 'smartyStringDouble', SyntaxOf('utf-8')

############################################

Given smarty (indent modifier):
  {$articleTitle|indent}
  {$articleTitle|indent:10}
  {$articleTitle|indent:10:"\t"}

Execute (indent modifier):
  AssertEqual 'smartyModifier', SyntaxOf('indent', 1)
  AssertEqual 'smartyModifier', SyntaxOf('indent', 2)
  AssertEqual 'smartyParameter', SyntaxOf('10', 1)
  AssertEqual 'smartyModifier', SyntaxOf('indent', 3)
  AssertEqual 'smartyParameter', SyntaxOf('10', 2)
  AssertEqual 'smartyStringDouble', SyntaxOf('\\t')

