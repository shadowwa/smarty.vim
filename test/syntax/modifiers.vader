  AssertEqual 'smartyModifier', SyntaxOf('unescape', 2)
  AssertEqual 'smartyString', SyntaxOf('html', 1)
  AssertEqual 'smartyModifier', SyntaxOf('unescape', 3)
  AssertEqual 'smartyString', SyntaxOf('html', 2)
  AssertEqual 'smartyString', SyntaxOf('utf-8')

