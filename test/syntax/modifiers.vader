Given smarty (split modifier):
  {foreach $ids|split:',' as $id}
    <li>{$id}</li>
  {/foreach}

Execute (split modifier):
  AssertEqual 'smartyModifier', SyntaxOf('split')
  AssertEqual 'smartyVariable', SyntaxOf('ids')
  AssertEqual 'smartyVariable', SyntaxOf('id', 2)
  AssertEqual 'smartyVariable', SyntaxOf('id', 3)

