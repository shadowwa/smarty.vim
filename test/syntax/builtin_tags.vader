Given smarty (assign tag):
  {assign var='name' value='Bob'}
  {assign 'name' 'Bob'}

Execute (assign tag and attributes):
  AssertEqual 'smartySTags', SyntaxOf('assign', 1)
  AssertEqual 'smartyProperty', SyntaxOf('var=')
  AssertEqual 'smartyString', SyntaxOf('name', 1)
  AssertEqual 'smartyProperty', SyntaxOf('value=')
  AssertEqual 'smartyString', SyntaxOf('Bob', 1)
  AssertEqual 'smartySTags', SyntaxOf('assign', 2)
  AssertEqual 'smartyString', SyntaxOf('name', 2)
  AssertEqual 'smartyString', SyntaxOf('Bob', 2)

