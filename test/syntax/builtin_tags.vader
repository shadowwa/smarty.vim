############################################

# step can be written with or without =
Given smarty (for tag with to and step):
  {for $i=1 to 10 step=2 max=5}
    {$i}
  {forelse}
    none
  {/for}

Execute (for tag):
  AssertEqual 'smartyDTags', SyntaxOf('for', 1)
  AssertEqual 'smartyVariable', SyntaxOf('i', 1)
  AssertEqual 'smartyNumber', SyntaxOf('1')
  AssertEqual 'smartyNumber', SyntaxOf('10')
  AssertEqual 'smartyProperty', SyntaxOf('step=')
  AssertEqual 'smartyNumber', SyntaxOf('2')
  AssertEqual 'smartyProperty', SyntaxOf('max=')
  AssertEqual 'smartyNumber', SyntaxOf('5')
  AssertEqual 'smartyVariable', SyntaxOf('i', 2)
  AssertEqual 'smartyConditional', SyntaxOf('forelse')
  AssertEqual 'smartyDTags', SyntaxOf('for', 3)

############################################

Given smarty (foreach tag smarty 3 syntax):
  {foreach $items as $item}
    {break}
    {continue}
    {$item@key}
    {$item@index}
    {$item@iteration}
    {$item@first}
    {$item@last}
    {$item@total}
    {$item@show}
  {foreachelse}
    no items
  {/foreach}

Execute (foreach tag smarty 3 syntax):
  AssertEqual 'smartyDRepeat', SyntaxOf('foreach', 1)
  AssertEqual 'smartyVariable', SyntaxOf('items')
  AssertEqual 'smartyVariable', SyntaxOf('item')
  AssertEqual 'smartyForeachConstruct', SyntaxOf('break')
  AssertEqual 'smartyForeachConstruct', SyntaxOf('continue')
  AssertEqual 'smartyForeachProperty', SyntaxOf('@key')
  AssertEqual 'smartyForeachProperty', SyntaxOf('@index')
  AssertEqual 'smartyForeachProperty', SyntaxOf('@iteration')
  AssertEqual 'smartyForeachProperty', SyntaxOf('@first')
  AssertEqual 'smartyForeachProperty', SyntaxOf('@last')
  AssertEqual 'smartyForeachProperty', SyntaxOf('@total')
  AssertEqual 'smartyForeachProperty', SyntaxOf('@show')
  AssertEqual 'smartyDRepeat', SyntaxOf('foreachelse')
  AssertEqual 'smartyDRepeat', SyntaxOf('foreach', 2)

############################################

Given smarty (foreach tag smarty 2 legacy syntax):
  {foreach from=$items key='k' item='v' name='myloop'}
    {$v}
  {/foreach}

Execute (foreach tag smarty 2 legacy syntax):
  AssertEqual 'smartyDRepeat', SyntaxOf('foreach', 1)
  AssertEqual 'smartyProperty', SyntaxOf('from=')
  AssertEqual 'smartyVariable', SyntaxOf('items')
  AssertEqual 'smartyProperty', SyntaxOf('key=')
  AssertEqual 'smartyString', SyntaxOf('k\>')
  AssertEqual 'smartyProperty', SyntaxOf('item=')
  AssertEqual 'smartyString', SyntaxOf('v\>')
  AssertEqual 'smartyProperty', SyntaxOf('name=')
  AssertEqual 'smartyString', SyntaxOf('myloop')
  AssertEqual 'smartyVariable', SyntaxOf('v', 2)
  AssertEqual 'smartyDRepeat', SyntaxOf('foreach', 2)

