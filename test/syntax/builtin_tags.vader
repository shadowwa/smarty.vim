    none
  {/section}

Execute (section tag):
  AssertEqual 'smartyDRepeat', SyntaxOf('section', 1)
  AssertEqual 'smartyProperty', SyntaxOf('name=')
  AssertEqual 'smartyString', SyntaxOf('customer', 1)
  AssertEqual 'smartyProperty', SyntaxOf('loop=')
  AssertEqual 'smartyVariable', SyntaxOf('custid', 1)
  AssertEqual 'smartyProperty', SyntaxOf('start=')
  AssertEqual 'smartyNumber', SyntaxOf('0')
  AssertEqual 'smartyProperty', SyntaxOf('step=')
  AssertEqual 'smartyNumber', SyntaxOf('1')
  AssertEqual 'smartyProperty', SyntaxOf('max=')
  AssertEqual 'smartyNumber', SyntaxOf('10')
  AssertEqual 'smartyProperty', SyntaxOf('show=')
  AssertEqual 'smartyBoolean', SyntaxOf('true')
  AssertEqual 'smartyVariable', SyntaxOf('custid', 2)
  AssertEqual 'smartyDRepeat', SyntaxOf('sectionelse')
  AssertEqual 'smartyDRepeat', SyntaxOf('section', 2)

