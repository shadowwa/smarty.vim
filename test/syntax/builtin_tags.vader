Given smarty (append tag):
  {append var='name' value='Bob' index='first'}

Execute (append tag and attributes):
  AssertEqual 'smartySTags', SyntaxOf('append')
  AssertEqual 'smartyProperty', SyntaxOf('var=')
  AssertEqual 'smartyString', SyntaxOf('name')
  AssertEqual 'smartyProperty', SyntaxOf('value=')
  AssertEqual 'smartyString', SyntaxOf('Bob')
  AssertEqual 'smartyCProperty', SyntaxOf('index=')
  AssertEqual 'smartyString', SyntaxOf('first')

