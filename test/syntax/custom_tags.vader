Given smarty (html_checkboxes tag):
  {html_checkboxes name='id' values=$ids checked=$checked separator='<br />'}

Execute (html_checkboxes tag):
  AssertEqual 'smartySTags', SyntaxOf('html_checkboxes')
  AssertEqual 'smartyProperty', SyntaxOf('name=')
  AssertEqual 'smartyString', SyntaxOf('id')
  AssertEqual 'smartyProperty', SyntaxOf('values=')
  AssertEqual 'smartyVariable', SyntaxOf('ids')
  AssertEqual 'smartyCProperty', SyntaxOf('checked=')
  AssertEqual 'smartyVariable', SyntaxOf('[$]\zschecked')
  AssertEqual 'smartyProperty', SyntaxOf('separator=')

