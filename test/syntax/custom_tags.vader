Given smarty (textformat tag):
  {textformat wrap=80 wrap_char="\n" indent=4 assign='formatted'}
    Long text here
  {/textformat}

Execute (textformat tag):
  AssertEqual 'smartyDTags', SyntaxOf('textformat', 1)
  AssertEqual 'smartyProperty', SyntaxOf('wrap=')
  AssertEqual 'smartyNumber', SyntaxOf('80')
  AssertEqual 'smartyProperty', SyntaxOf('wrap_char=')
  AssertEqual 'smartyProperty', SyntaxOf('indent=')
  AssertEqual 'smartyNumber', SyntaxOf('4')
  AssertEqual 'smartyProperty', SyntaxOf('assign=')
  AssertEqual 'smartyString', SyntaxOf('formatted')
  AssertEqual 'smartyDTags', SyntaxOf('textformat', 2)
