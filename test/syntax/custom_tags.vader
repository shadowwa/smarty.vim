Given smarty (counter tag):
  {counter start=0 skip=2 print=false assign='counter_val'}

Execute (counter tag and attributes):
  AssertEqual 'smartySRepeat', SyntaxOf('counter')
  AssertEqual 'smartyProperty', SyntaxOf('start=')
  AssertEqual 'smartyNumber', SyntaxOf('0')
  AssertEqual 'smartyProperty', SyntaxOf('skip=')
  AssertEqual 'smartyNumber', SyntaxOf('2')
  AssertEqual 'smartyProperty', SyntaxOf('print=')
  AssertEqual 'smartyBoolean', SyntaxOf('false')
  AssertEqual 'smartySTags', SyntaxOf('assign=')
  AssertEqual 'smartyString', SyntaxOf('counter_val')

