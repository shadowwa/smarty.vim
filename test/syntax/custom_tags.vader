Given smarty (html_select_date and html_select_time tags):
  {html_select_date start_year=2000 end_year=2030 display_days=true}
  {html_select_time use_24_hours=true display_seconds=false}

Execute (html_select_date and html_select_time tags):
  AssertEqual 'smartySTags', SyntaxOf('html_select_date')
  AssertEqual 'smartyProperty', SyntaxOf('start_year=')
  AssertEqual 'smartyNumber', SyntaxOf('2000')
  AssertEqual 'smartyProperty', SyntaxOf('end_year=')
  AssertEqual 'smartyNumber', SyntaxOf('2030')
  AssertEqual 'smartyProperty', SyntaxOf('display_days=')
  AssertEqual 'smartyBoolean', SyntaxOf('true', 1)
  AssertEqual 'smartySTags', SyntaxOf('html_select_time')
  AssertEqual 'smartyProperty', SyntaxOf('use_24_hours=')
  AssertEqual 'smartyBoolean', SyntaxOf('true', 2)
  AssertEqual 'smartyProperty', SyntaxOf('display_seconds=')
  AssertEqual 'smartyBoolean', SyntaxOf('false')

