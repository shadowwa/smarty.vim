Given smarty (math tag):
  {math equation='x + y' x=$val1 y=$val2 assign='sum'}

Execute (math tag):
  AssertEqual 'smartySTags', SyntaxOf('math')
  AssertEqual 'smartyProperty', SyntaxOf('equation=')
  AssertEqual 'smartyString', SyntaxOf('x + y')
  AssertEqual 'smartyCProperty', SyntaxOf('x=')
  AssertEqual 'smartyVariable', SyntaxOf('val1')
  AssertEqual 'smartyCProperty', SyntaxOf('y=')
  AssertEqual 'smartyVariable', SyntaxOf('val2')
  AssertEqual 'smartySTags', SyntaxOf('assign=')
  AssertEqual 'smartyString', SyntaxOf('sum')

