Given smarty (cycle tag):
  {cycle values='odd,even' assign='row_class' reset=true}

Execute (cycle tag and attributes):
  AssertEqual 'smartySRepeat', SyntaxOf('cycle')
  AssertEqual 'smartyProperty', SyntaxOf('values=')
  AssertEqual 'smartyString', SyntaxOf('odd,even')
  AssertEqual 'smartySTags', SyntaxOf('assign=')
  AssertEqual 'smartyString', SyntaxOf('row_class')
  AssertEqual 'smartyProperty', SyntaxOf('reset=')
  AssertEqual 'smartyBoolean', SyntaxOf('true')

