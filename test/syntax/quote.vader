############################################

Given smarty (plugin result):
  {func var="test {counter} test"}

Execute (plugin result):
  AssertEqual 'smartySRepeat', SyntaxOf('counter')

############################################

Given smarty (Smarty block function):
  {func var="variable foo is {if !$foo}not {/if} defined"}

Execute (Smarty block function):
  AssertEqual 'smartyStringDouble', SyntaxOf('foo', 1)
  AssertEqual 'smartyConditional', SyntaxOf('if', 1)
  AssertEqual 'smartyDollarSign', SyntaxOf('\$')
  AssertEqual 'smartyVariable', SyntaxOf('foo', 2)
  AssertEqual 'smartyStringDouble', SyntaxOf('not')
  AssertEqual 'smartyConditional', SyntaxOf('if', 2)
  AssertEqual 'smartyStringDouble', SyntaxOf('defined')

############################################
